{
  "name": "@b2b/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --migration-file-language sql --envPath ../../.env --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --migration-file-language sql --envPath ../../.env --database-url-var DATABASE_URL",
    "migrate:prod": "node-pg-migrate up --migrations-dir apps/api/migrations --migration-file-language sql --database-url-var DATABASE_URL",
    "admin:create": "NODE_OPTIONS=--conditions=development tsx src/scripts/create-admin.ts",
    "seed:demo": "NODE_OPTIONS=--conditions=development tsx src/scripts/seed-companies.ts",
    "import:partners": "NODE_OPTIONS=--conditions=development tsx src/scripts/import-partners.ts"
  },
  "dependencies": {
    "@b2b/shared": "*",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-pg-migrate": "^7.9.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
