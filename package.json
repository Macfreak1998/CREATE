{
  "name": "b2b-matchmaking",
  "version": "0.1.0",
  "private": true,
  "description": "B2B-Matchmaking-Plattform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm-run-all build:*",
    "build:shared": "npm --workspace packages/shared run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm-run-all lint:*",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint",
    "migrate:up": "npm --workspace apps/api run migrate:up",
    "migrate:down": "npm --workspace apps/api run migrate:down",
    "admin:create": "npm --workspace apps/api run admin:create",
    "seed:demo": "npm --workspace apps/api run seed:demo"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
