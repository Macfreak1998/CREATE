# Root-Level .env (wird von Docker Compose genutzt)

# PostgreSQL
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_dev_password
POSTGRES_DB=b2b_matchmaking
POSTGRES_PORT=5432

# API
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://b2b:b2b_dev_password@postgres:5432/b2b_matchmaking
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
COOKIE_SECRET=change-me-in-production-please-use-a-long-random-string
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=/app/uploads
PUBLIC_UPLOADS_BASE_URL=http://localhost:4000/uploads

# Frontend-Basis-URL (wird in E-Mail-Texten als Linkziel verwendet,
# z. B. fuer Reset-Links und Admin-Notifications).
APP_BASE_URL=http://localhost:5173

# Mail (SMTP). In Dev verweist Mailpit unter http://localhost:8025
# auf die Web-UI fuer eingehende Mails.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CREATE <noreply@create-cluster.local>

# Mailpit (Dev-Container)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000
